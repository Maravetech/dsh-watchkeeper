{
  "name": "dsh-watchkeeper",
  "version": "0.2.0",
  "description": "Watch unattended DeepSeek Harness sessions: session numbers, a pending-answer seat for decision cards, and a pluggable judge that answers mid-session questions or hands them to a human.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./host": "./lib/host.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "locale/*.json",
    "icon.svg",
    "config/*.json",
    "skills/"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.5",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "plugin",
    "watch",
    "on-call",
    "human-in-the-loop",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Maravetech/dsh-watchkeeper.git"
  },
  "bugs": {
    "url": "https://github.com/Maravetech/dsh-watchkeeper/issues"
  },
  "homepage": "https://github.com/Maravetech/dsh-watchkeeper",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "author": "marave"
}
